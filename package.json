{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "kind-words",
  "title": "Kind Words",
  "description": "Random compliments and gratitude prompts to lift the mood.",
  "icon": "extension-icon.png",
  "author": "almatkai",
  "categories": [
    "Fun"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "random-compliment",
      "title": "Random Compliment",
      "description": "Browse compliments with one preselected at random; filter by tone.",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    },
    {
      "name": "quick-compliment",
      "title": "Quick Compliment",
      "description": "Copy a random compliment instantly.",
      "mode": "no-view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    },
    {
      "name": "gratitude-note",
      "title": "Gratitude Note",
      "description": "Browse gratitude prompts with usage notes and opener examples.",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "id": "com.tezbar.kind-words",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/kind-words",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/kind-words",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
